; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jump Game 2D"
run/main_scene="res://scenes/main_2d.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/mode=2
window/stretch/mode="2d"
window/stretch/aspect="expand"
window/size/resizable=true
window/resizeable=true

[input]

jump={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"double_click":false,"script":null)
]
}

[physics]

2d/default_gravity=980.0
2d/default_gravity_vector=Vector2(0, 1)
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"

[mobile]

gles2d/thread_model="gl_compatibility"

